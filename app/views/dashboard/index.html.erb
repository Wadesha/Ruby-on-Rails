<h1>系统概览</h1>

<div style="display: flex; gap: 20px; margin-bottom: 30px;">
  <div style="flex: 1; background: #e3f2fd; padding: 20px; border-radius: 8px; text-align: center;">
    <h2 style="margin: 0; font-size: 36px; color: #1565c0;"><%= @customer_count %></h2>
    <p style="margin: 5px 0 0; color: #666;">客户数量</p>
    <%= link_to "查看客户", customers_path, style: "color: #1565c0;" %>
  </div>
  <div style="flex: 1; background: #e8f5e9; padding: 20px; border-radius: 8px; text-align: center;">
    <h2 style="margin: 0; font-size: 36px; color: #2e7d32;"><%= @product_count %></h2>
    <p style="margin: 5px 0 0; color: #666;">产品数量</p>
    <%= link_to "查看产品", products_path, style: "color: #2e7d32;" %>
  </div>
  <div style="flex: 1; background: #fff3e0; padding: 20px; border-radius: 8px; text-align: center;">
    <h2 style="margin: 0; font-size: 36px; color: #e65100;"><%= @order_count %></h2>
    <p style="margin: 5px 0 0; color: #666;">订单数量</p>
    <%= link_to "查看订单", orders_path, style: "color: #e65100;" %>
  </div>
  <div style="flex: 1; background: #f3e5f5; padding: 20px; border-radius: 8px; text-align: center;">
    <h2 style="margin: 0; font-size: 36px; color: #6a1b9a;">¥<%= number_with_delimiter(@total_revenue) %></h2>
    <p style="margin: 5px 0 0; color: #666;">总营收</p>
  </div>
</div>

<h2>最近订单</h2>
<table style="width: 100%; border-collapse: collapse;">
  <thead>
    <tr style="background: #f5f5f5;">
      <th style="padding: 10px; text-align: left; border-bottom: 2px solid #ddd;">订单号</th>
      <th style="padding: 10px; text-align: left; border-bottom: 2px solid #ddd;">客户</th>
      <th style="padding: 10px; text-align: left; border-bottom: 2px solid #ddd;">产品</th>
      <th style="padding: 10px; text-align: left; border-bottom: 2px solid #ddd;">数量</th>
      <th style="padding: 10px; text-align: left; border-bottom: 2px solid #ddd;">总价</th>
      <th style="padding: 10px; text-align: left; border-bottom: 2px solid #ddd;">状态</th>
      <th style="padding: 10px; text-align: left; border-bottom: 2px solid #ddd;">日期</th>
    </tr>
  </thead>
  <tbody>
    <% @recent_orders.each do |order| %>
      <tr>
        <td style="padding: 10px; border-bottom: 1px solid #eee;"><%= link_to "##{order.id}", order %></td>
        <td style="padding: 10px; border-bottom: 1px solid #eee;"><%= order.customer&.name %></td>
        <td style="padding: 10px; border-bottom: 1px solid #eee;"><%= order.product&.name %></td>
        <td style="padding: 10px; border-bottom: 1px solid #eee;"><%= order.quantity %></td>
        <td style="padding: 10px; border-bottom: 1px solid #eee;">¥<%= order.total_price %></td>
        <td style="padding: 10px; border-bottom: 1px solid #eee;"><%= order.status %></td>
        <td style="padding: 10px; border-bottom: 1px solid #eee;"><%= order.order_date %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<% if @recent_orders.empty? %>
  <p style="color: #999; text-align: center; padding: 20px;">暂无订单数据，请先添加客户、产品和订单。</p>
<% end %>
